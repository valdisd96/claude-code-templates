{
  "permissions": {
    "allow": [
      "Bash(helm lint*)",
      "Bash(helm template*)",
      "Bash(helm dependency*)",
      "Bash(helm show*)",
      "Bash(helm search*)",
      "Bash(helm list*)",
      "Bash(helm status*)",
      "Bash(helm get*)",
      "Bash(helm history*)",
      "Bash(helm repo*)",
      "Bash(helm install*--dry-run*)",
      "Bash(helm upgrade*--dry-run*)",
      "Bash(helm diff*)",
      "Bash(helm plugin*)",
      "Bash(helm env*)",
      "Bash(helm version*)",
      "Bash(helm package*)",
      "Bash(helm verify*)",
      "Bash(helm pull*)",
      "Bash(helm create*)",
      "Bash(kubectl apply*--dry-run*)",
      "Bash(kubectl diff*)",
      "Bash(kubectl explain*)",
      "Bash(kubectl api-resources*)",
      "Bash(yq*)",
      "Bash(jq*)"
    ],
    "deny": [
      "Bash(helm install)*",
      "Bash(helm upgrade)*",
      "Bash(helm uninstall*)",
      "Bash(helm delete*)",
      "Bash(helm rollback*)",
      "Bash(kubectl apply)*",
      "Bash(kubectl create)*",
      "Bash(kubectl delete)*",
      "Bash(kubectl patch)*",
      "Bash(kubectl edit)*",
      "Bash(rm -rf /)*",
      "Bash(rm -rf ~)*",
      "Bash(rm -rf .)*"
    ]
  },
  "env": {
    "HELM_CACHE_HOME": "${HOME}/.cache/helm",
    "HELM_CONFIG_HOME": "${HOME}/.config/helm",
    "HELM_DATA_HOME": "${HOME}/.local/share/helm"
  }
}
